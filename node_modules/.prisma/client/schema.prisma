generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Receipt {
  id          String   @id @db.VarChar(40)
  capturedAt  DateTime @map("captured_at")
  amount      Decimal? @db.Decimal(12, 2)
  currency    String   @db.VarChar(8)
  receiptDate String?  @map("receipt_date") @db.VarChar(16)
  merchant    String?  @db.VarChar(120)
  ocrText     String   @map("ocr_text") @db.Text
  status      String   @db.VarChar(16)
  imageMime   String?  @map("image_mime") @db.VarChar(40)
  imageB64    String?  @map("image_b64") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([capturedAt])
  @@map("receipts")
}

model SyncEvent {
  id        Int      @id @default(autoincrement())
  receiptId String   @map("receipt_id") @db.VarChar(40)
  action    String   @db.VarChar(24)
  detail    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([receiptId])
  @@map("sync_events")
}
